@page
@model PersonasModel
@{
    ViewData["Title"] = "Personas";
}

<h1>Detecciones</h1>
<p class="subtitle">Personas vistas por las cámaras y padrón de personas conocidas.</p>

<partial name="_DeteccionesTabs" model="@("personas")" />

@if (Model.DatabaseError is not null)
{
    <div class="alert alert-error">
        <b>No se pudo consultar la base de datos:</b> @Model.DatabaseError<br />
        Revise los datos en <a asp-page="/Configuracion/Index">Configuración → Base de datos</a>.
    </div>
}

<div class="card" style="margin-bottom:16px">
    <h2>Personas detectadas (@Model.UnknownFacesTotal)</h2>
    <p class="subtitle">
        Todas las personas vistas por las cámaras, de la más reciente a la más antigua.
        A las no identificadas puede ponerles nombre para darlas de alta con ese mismo rostro
        (quedan como «no autorizadas» hasta revisarlas). Doble clic sobre la foto la amplía.
    </p>
    <form method="get" class="filters" style="margin-bottom:12px">
        <div class="field">
            <label for="Camara">Cámara</label>
            <select id="Camara" name="Camara">
                <option value="">Todas</option>
                @foreach (var cam in Model.CamerasDisponibles)
                {
                    <option value="@cam" selected="@(Model.Camara == cam)">@cam</option>
                }
            </select>
        </div>
        <button type="submit" class="btn secondary">Filtrar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Camara))
        {
            <a class="btn secondary" asp-page="/Personas">Quitar filtro</a>
        }
    </form>

    <form method="post" asp-page-handler="LimpiarDetecciones" class="actions"
          style="gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center"
          onsubmit="return confirm('¿Borrar las detecciones de personas según el filtro indicado? No se puede deshacer.');">
        <input type="hidden" name="camara" value="@Model.Camara" />
        <span class="hint">Eliminar registros:</span>
        <select name="dias" style="max-width:150px">
            <option value="0">todos</option>
            <option value="1">de más de 1 día</option>
            <option value="7">de más de 7 días</option>
            <option value="30">de más de 30 días</option>
        </select>
        <label class="check" style="margin:0">
            <input type="checkbox" name="soloNoIdentificadas" value="true" checked /> sólo sin identificar
        </label>
        @if (!string.IsNullOrWhiteSpace(Model.Camara))
        {
            <span class="badge badge-muted">sólo de @Model.Camara</span>
        }
        <button class="btn small danger" type="submit">Eliminar</button>
    </form>

    @if (Model.UnknownFaces.Count == 0)
    {
        <div class="empty">Todavía no hay detecciones de personas.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Foto</th>
                        <th>Nombre</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Cámara</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var face in Model.UnknownFaces)
                {
                    var local = face.OccurredAt.ToLocalTime();
                    <tr>
                        <td data-col="Foto" class="thumb-cell">
                            @if (!string.IsNullOrEmpty(face.CropBase64))
                            {
                                <img src="data:image/jpeg;base64,@face.CropBase64" alt="Persona detectada" />
                            }
                            else
                            {
                                <img src="/media/recorte?path=@Uri.EscapeDataString(face.CropPath!)" alt="Persona detectada" loading="lazy" />
                            }
                        </td>
                        <td data-col="Nombre">
                            @if (face.IsKnown)
                            {
                                <b>@face.Label</b> <span class="badge badge-ok">identificada</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">sin identificar</span>
                            }
                        </td>
                        <td data-col="Fecha">@local.ToString("dd/MM/yyyy")</td>
                        <td data-col="Hora">
                            @local.ToString("HH:mm:ss")
                            @if (face.Repeticiones > 1)
                            {
                                <span class="badge badge-muted" title="Detecciones agrupadas de la misma cámara en 10 minutos">×@face.Repeticiones</span>
                            }
                        </td>
                        <td data-col="Cámara">@face.CameraName</td>
                        <td class="acciones">
                            @if (!face.IsKnown)
                            {
                                <form method="post" asp-page-handler="AltaDesdeEvento" class="actions" style="gap:6px">
                                    <input type="hidden" name="eventoId" value="@face.EventId" />
                                    <input name="nombre" placeholder="Nombre" required style="max-width:140px" />
                                    <button class="btn small" type="submit">Alta</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="actions" style="margin-top:12px; align-items:center">
                @if (Model.Pagina > 1)
                {
                    <a class="btn small secondary" asp-page="/Personas" asp-route-Camara="@Model.Camara"
                       asp-route-Buscar="@Model.Buscar" asp-route-Pagina="@(Model.Pagina - 1)">← Anteriores</a>
                }
                <span class="hint">Página @Model.Pagina de @Model.TotalPaginas</span>
                @if (Model.Pagina < Model.TotalPaginas)
                {
                    <a class="btn small secondary" asp-page="/Personas" asp-route-Camara="@Model.Camara"
                       asp-route-Buscar="@Model.Buscar" asp-route-Pagina="@(Model.Pagina + 1)">Siguientes →</a>
                }
            </div>
        }
    }
</div>

<div class="grid grid-live">
    <div class="card">
        <div class="filters" style="margin-bottom:16px">
            <form method="get" class="filters">
                <div class="field">
                    <label for="Buscar">Buscar</label>
                    <input type="search" id="Buscar" name="Buscar" value="@Model.Buscar" placeholder="Nombre, documento o área" />
                </div>
                <button type="submit" class="btn secondary">Buscar</button>
                @if (!string.IsNullOrWhiteSpace(Model.Buscar))
                {
                    <a class="btn secondary" asp-page="/Personas">Limpiar</a>
                }
            </form>
        </div>

        @if (Model.People.Count == 0)
        {
            <div class="empty">No hay personas registradas.</div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Documento</th>
                            <th>Área</th>
                            <th>Rostros</th>
                            <th>Acceso</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.People)
                    {
                        <tr>
                            <td data-col="Nombre">
                                <a asp-page="/Persona" asp-route-id="@p.Id"><b>@p.FullName</b></a>
                                @if (!p.IsActive)
                                {
                                    <span class="badge badge-muted">inactiva</span>
                                }
                            </td>
                            <td data-col="Documento">@(p.DocumentId ?? "—")</td>
                            <td data-col="Área">@(p.Department ?? "—")</td>
                            <td data-col="Rostros">
                                @if (p.Templates == 0)
                                {
                                    <span class="badge badge-warn">sin fotos</span>
                                }
                                else
                                {
                                    @p.Templates
                                }
                            </td>
                            <td data-col="Acceso">
                                @if (p.IsAuthorized)
                                {
                                    <span class="badge badge-ok">autorizada</span>
                                }
                                else
                                {
                                    <span class="badge badge-warn">no autorizada</span>
                                }
                            </td>
                            <td class="acciones" style="white-space:nowrap">
                                <a class="btn small secondary" asp-page="/Persona" asp-route-id="@p.Id">Abrir</a>
                                <form method="post" style="display:inline"
                                      onsubmit="return confirm('¿Eliminar a @p.FullName y todas sus plantillas?');">
                                    <button class="btn small danger" asp-page-handler="Eliminar" asp-route-id="@p.Id">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card">
        <h2>Nueva persona</h2>
        <form method="post">
            <div class="field">
                <label asp-for="NewPerson.FullName">Nombre completo</label>
                <input asp-for="NewPerson.FullName" required />
            </div>
            <div class="field">
                <label asp-for="NewPerson.DocumentId">Documento</label>
                <input asp-for="NewPerson.DocumentId" />
            </div>
            <div class="field">
                <label asp-for="NewPerson.Department">Área o departamento</label>
                <input asp-for="NewPerson.Department" />
            </div>
            <div class="check">
                <input asp-for="NewPerson.IsAuthorized" type="checkbox" checked />
                <label asp-for="NewPerson.IsAuthorized">Acceso autorizado</label>
            </div>
            <div class="field">
                <label asp-for="NewPerson.Notes">Notas</label>
                <textarea asp-for="NewPerson.Notes"></textarea>
            </div>
            <button type="submit" class="btn" asp-page-handler="Crear">Crear persona</button>
        </form>
    </div>
</div>
