@{
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool Active(string prefix) => current.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · Cerbero Garage</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/iconos/icono-192.png" />

    <!-- Aplicación instalable (PWA): Chrome/Edge «Instalar», Safari «Añadir al Dock / pantalla de inicio» -->
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#0b0e13" />
    <link rel="apple-touch-icon" href="~/iconos/icono-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Cerbero Garage" />
    <script src="~/js/pwa.js" asp-append-version="true" defer></script>
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Directo">
            <span class="brand-mark">CG</span>
            <span class="brand-name">Cerbero Garage</span>
        </a>
        <nav class="nav">
            <a asp-page="/Directo" class="@(Active("/Directo") ? "active" : "")">Directo</a>
            <a asp-page="/Monitoreo" class="@(Active("/Monitoreo") ? "active" : "")">Monitoreo</a>
            <a asp-page="/Dashboard" class="@(Active("/Dashboard") ? "active" : "")">Dashboard</a>
            <a asp-page="/Personas" class="@(Active("/Personas") ? "active" : "")">Personas</a>
            <a asp-page="/Vehiculos" class="@(Active("/Vehiculos") ? "active" : "")">Vehículos</a>
            <a asp-page="/Objetos" class="@(Active("/Objetos") ? "active" : "")">Objetos</a>
            <a asp-page="/Eventos" class="@(Active("/Eventos") ? "active" : "")">Eventos</a>
            @if (User.IsInRole("Administrator"))
            {
                <a asp-page="/Usuarios" class="@(Active("/Usuarios") ? "active" : "")">Usuarios</a>
                <a asp-page="/Configuracion/Index" class="@(Active("/Configuracion") ? "active" : "")">Configuración</a>
            }
        </nav>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-page="/Login" asp-page-handler="Salir" style="margin-left:auto;display:flex;align-items:center;gap:10px">
                <span class="hint">@User.Identity.Name</span>
                <button class="btn small secondary" type="submit">Salir</button>
            </form>
        }
    </header>

    <main class="content">
        @if (TempData["Ok"] is string ok)
        {
            <div class="alert alert-ok">@ok</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-error">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        Cerbero Garage · reconocimiento facial, de matrículas y de objetos en local ·
        <a href="/api/docs" target="_blank">API REST</a> ·
        <a href="/api/camaras" target="_blank">/api/camaras</a>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
