@{
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool Active(string prefix) => current.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · ExoGuardian</title>
    @* Tema claro/oscuro de Exowise: va antes del CSS y sin defer para que la página no parpadee. *@
    <script src="~/js/exowise-tema.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/iconos/icono-192.png" />

    <!-- Aplicación instalable (PWA): Chrome/Edge «Instalar», Safari «Añadir al Dock / pantalla de inicio» -->
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#f7f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="~/iconos/icono-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ExoGuardian" />
    <script src="~/js/pwa.js" asp-append-version="true" defer></script>
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Directo" aria-label="Exowise · ExoGuardian">
            <img class="brand-mark claro" src="~/marca/logo.svg" alt="" />
            <img class="brand-mark oscuro" src="~/marca/logo-dark-bg.svg" alt="" />
            <span class="brand-word">Exowise</span>
            <span class="brand-sep" aria-hidden="true"></span>
            <span class="brand-name">ExoGuardian</span>
        </a>
        <nav class="nav">
            <a asp-page="/Dashboard" class="@(Active("/Dashboard") ? "active" : "")">Dashboard</a>
            <a asp-page="/Monitoreo" class="@(Active("/Monitoreo") || Active("/Directo") ? "active" : "")">Monitoreo</a>
            <a asp-page="/Personas" class="@(Active("/Persona") || Active("/Vehiculo") || Active("/Objetos") ? "active" : "")">Detecciones</a>
            <a asp-page="/Eventos" class="@(Active("/Eventos") ? "active" : "")">Eventos</a>
            @if (User.IsInRole("Administrator"))
            {
                <a asp-page="/Configuracion/Index" class="@(Active("/Configuracion") || Active("/Usuarios") ? "active" : "")">Configuración</a>
            }
            <button class="btn small secondary" type="button" id="btnAvisosPush" hidden>🔕</button>
        </nav>
        <div class="topbar-acciones">
            @* Aparece solo si el navegador permite instalar la aplicación. *@
            <button class="btn small secondary" type="button" id="btnInstalarApp" hidden
                    title="Instalar ExoGuardian como aplicación">⬇ Instalar app</button>
            <div data-exowise-tema></div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" asp-page="/Login" asp-page-handler="Salir">
                    <span class="hint">@User.Identity.Name</span>
                    <button class="btn small secondary" type="submit">Salir</button>
                </form>
            }
        </div>
    </header>

    <main class="content">
        @if (TempData["Ok"] is string ok)
        {
            <div class="alert alert-ok">@ok</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-error">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        ExoGuardian · Exowise Labs · reconocimiento facial, de matrículas y de objetos en local ·
        <a href="/api/docs" target="_blank">API REST</a> ·
        <a href="/api/camaras" target="_blank">/api/camaras</a>
    </footer>

    <script src="~/js/lightbox.js" asp-append-version="true" defer></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/avisos.js" asp-append-version="true" defer></script>
    <script src="~/js/push-avisos.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
