@page
@model DirectoModel
@{
    ViewData["Title"] = "Directo";
}

<h1>Vigilancia en directo</h1>
<p class="subtitle">Vídeo con los objetos identificados, rostros reconocidos y matrículas leídas en tiempo real.</p>

@if (!Model.Models.FacesAvailable || !Model.Models.PlatesAvailable || !Model.Models.ObjectsAvailable)
{
    <div class="alert alert-info">
        @if (!Model.Models.FacesAvailable)
        {
            <div><b>Reconocimiento facial no disponible:</b> @(Model.Models.FaceError ?? "modelos sin cargar").</div>
        }
        @if (!Model.Models.PlatesAvailable)
        {
            <div><b>Lectura de matrículas no disponible:</b> @(Model.Models.PlateError ?? "modelos sin cargar").</div>
        }
        @if (!Model.Models.ObjectsAvailable)
        {
            <div><b>Detección de objetos no disponible:</b> @(Model.Models.ObjectError ?? "modelos sin cargar").</div>
        }
        <div>Revise las rutas en <a asp-page="/Configuracion/Index">Configuración → Modelos</a>.</div>
    </div>
}

@if (Model.Cameras.Count == 0)
{
    <div class="card">
        <h2>Todavía no hay cámaras</h2>
        <p class="subtitle">Añada una cámara Hikvision o compatible para empezar a recibir vídeo.</p>
        <a class="btn" asp-page="/Configuracion/Camara">Añadir cámara</a>
    </div>
}
else
{
    <div class="cam-tabs" id="camTabs">
        @foreach (var cam in Model.Cameras)
        {
            <button type="button" class="cam-tab" data-camera="@cam.Id">@cam.Name</button>
        }
    </div>

    <div class="grid grid-live">
        <div>
            <div class="video-shell">
                <img id="videoFeed" alt="Vídeo en directo" />
            </div>
            <div class="status-strip">
                <span><span class="dot" id="stDot"></span><b id="stState">—</b></span>
                <span>Resolución: <b id="stRes">—</b></span>
                <span>Fps: <b id="stFps">—</b></span>
                <span>Analizados: <b id="stFrames">0</b></span>
                <span id="stError" class="badge badge-danger" hidden></span>
            </div>
        </div>

        <div>
            <div class="card">
                <h3>Rostros</h3>
                <div class="feed" id="feedFaces"></div>
            </div>
            <div class="card">
                <h3>Matrículas</h3>
                <div class="feed" id="feedPlates"></div>
            </div>
            <div class="card">
                <h3>Objetos</h3>
                <div class="feed" id="feedObjects"></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        window.IVZ = {
            camaras: @Html.Raw(WebJson.Serialize(
                Model.Cameras.Select(c => new { id = c.Id.ToString(), nombre = c.Name }))),
            estados: @Html.Raw(WebJson.Serialize(
                Model.Statuses.Select(s => new CameraStatusDto(
                    s.CameraId.ToString(), s.Name, s.Connected, s.State, s.LastError,
                    s.MeasuredFps,
                    s.FrameWidth > 0 ? $"{s.FrameWidth}×{s.FrameHeight}" : "—",
                    s.FramesProcessed)))),
            recientes: @Html.Raw(WebJson.Serialize(Model.Recent))
        };
    </script>
    <script src="~/js/live.js" asp-append-version="true"></script>
}
