@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
<p class="subtitle">Resumen en tiempo real. <span class="hint" id="dashActualizado"></span></p>

@if (Model.DatabaseError is not null)
{
    <div class="alert alert-error">No se pudo consultar la base de datos: @Model.DatabaseError</div>
}

<div class="grid grid-3" id="dashCards">
    <div class="card dash-card">
        <div class="dash-num" data-campo="vehiculosHoy">@Model.Summary.VehiculosHoy</div>
        <div class="dash-label">Vehículos hoy</div>
        <div class="hint">
            <span data-campo="vehiculosNuevosHoy">@Model.Summary.VehiculosNuevosHoy</span> nuevos ·
            <span data-campo="vehiculosRecurrentesHoy">@Model.Summary.VehiculosRecurrentesHoy</span> ya vistos antes
        </div>
    </div>
    <div class="card dash-card">
        <div class="dash-num" data-campo="vehiculosTotal">@Model.Summary.VehiculosTotal</div>
        <div class="dash-label">Vehículos distintos (histórico)</div>
    </div>
    <div class="card dash-card">
        <div class="dash-num" data-campo="rostrosHoy">@Model.Summary.RostrosHoy</div>
        <div class="dash-label">Rostros hoy</div>
    </div>
    <div class="card dash-card">
        <div class="dash-num" data-campo="objetosHoy">@Model.Summary.ObjetosHoy</div>
        <div class="dash-label">Objetos hoy</div>
    </div>
    <div class="card dash-card">
        <div class="dash-num" data-campo="eventosHoy">@Model.Summary.EventosHoy</div>
        <div class="dash-label">Eventos totales hoy</div>
    </div>
</div>

<div class="card" style="margin-top:16px">
    <h2>Últimos vehículos vistos</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Matrícula</th>
                    <th>Identificación</th>
                    <th>Memoria</th>
                    <th>Veces visto</th>
                    <th>Primera vez</th>
                    <th>Última vez</th>
                    <th>Cámara</th>
                </tr>
            </thead>
            <tbody id="dashVehiculos">
            @foreach (var v in Model.Summary.UltimosVehiculos)
            {
                <tr>
                    <td class="plate"><b>@v.Matricula</b></td>
                    <td>@v.Etiqueta @if (v.Registrado) { <span class="badge badge-ok">registrado</span> }</td>
                    <td>
                        @if (v.YaVistoAntes)
                        {
                            <span class="badge badge-warn">ya visto antes</span>
                        }
                        else
                        {
                            <span class="badge badge-muted">primera vez</span>
                        }
                    </td>
                    <td>@v.VecesVisto</td>
                    <td>@v.PrimeraVez.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    <td>@v.UltimaVez.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    <td>@v.UltimaCamara</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Summary.UltimosVehiculos.Count == 0)
    {
        <div class="empty">Todavía no se ha leído ninguna matrícula.</div>
    }
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
