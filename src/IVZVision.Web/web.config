<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración para el despliegue en IIS.
  La cadena de conexión a la base de datos es un PARÁMETRO de este fichero:
  edite el valor de ConnectionStrings__IVZVision y reinicie el sitio.
  Si se deja vacío, la conexión se configura desde la propia web (Configuración).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\IVZVision.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ConnectionStrings__IVZVision"
                               value="Server=.\SQLEXPRESS;Database=IVZVision;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=true" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
